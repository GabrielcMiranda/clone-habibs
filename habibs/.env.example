# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker
SHOW_SQL=true

# Database
DB_NAME=habibs
DB_USERNAME=postgres
DB_PASSWORD=change-this-password

# JWT
JWT_ISSUER=habibs-api
JWT_ACCESS_TOKEN_TTL_HOURS=6
# Use classpath values when keys are packaged in src/main/resources
JWT_PUBLIC_KEY_LOCATION=classpath:public.pem
JWT_PRIVATE_KEY_LOCATION=classpath:private.pem

# If you prefer external keys mounted into the container, use:
# JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt/public.pem
# JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt/private.pem
